{
  "name": "reset-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/auth.config.ts --output src/lib/db/auth-schema.ts --adapter drizzle --dialect postgresql --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.13",
    "better-auth": "1.7.13",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "auth": "1.7.13",
    "drizzle-kit": "^0.31.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
